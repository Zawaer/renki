# Copy to .env at the repo root and fill in. The daemon auto-loads it.
# Generate a token with:  pnpm --filter @crc/daemon cli token

# Shared secret every client must present. REQUIRED once you bind off-loopback.
CRC_AUTH_TOKEN=

# Folder that CONTAINS your git project folders (each subfolder = one repo).
CRC_REPOS_ROOT=/home/you/coding

# Where the daemon stores its SQLite db + per-session worktrees.
CRC_DATA_DIR=/home/you/claude-remote-control/data

# Bind address + port.
#   127.0.0.1  -> private; expose over the tailnet with `tailscale serve` (recommended)
#   0.0.0.0    -> reachable on all interfaces incl. the tailnet IP (needs a token)
CRC_HOST=127.0.0.1
CRC_PORT=4517

# Route EVERY gated tool through the controller's approval (ignore your personal
# ~/.claude allow-lists). Recommended once you're approving from your phone.
# CRC_FORCE_PERMISSION_PROMPTS=1

# Minutes of controller silence before the take-control lock auto-releases.
CRC_CONTROL_IDLE_MINUTES=15

# Seconds a permission request waits for the controller before auto-denying.
CRC_PERMISSION_TIMEOUT_SECONDS=300

# ── Multi-account usage rotation (needs `cswap` installed + accounts added) ──
# Automates the manual "cswap --switch-account when I hit my limit" habit. The
# daemon reads usage via cswap and, when the active account nears its limit,
# tells cswap to swap which account the `claude` CLI loads at next startup.
# CRC_ACCOUNT_ROTATION=1
CRC_CSWAP_BIN=cswap
CRC_ROTATION_THRESHOLD=90
CRC_ROTATION_COOLDOWN_MINUTES=5
CRC_ROTATION_POLL_SECONDS=60
CRC_ROTATION_STRATEGY=best   # best | next-available
# On a rate-limit failure, switch account and retry the prompt once (default on):
# CRC_ROTATION_AUTORETRY=1

# Usage % display: read-only claude.ai session keys (separate from coding
# setup-tokens). Easiest is to tap "Connect usage %" in any client, or run
# `crc usage login` / `crc usage connect <key>`. The daemon resolves the org +
# email from the key, so orgId is no longer required. Stored (gitignored) at
# <data dir>/usage-accounts.json — override the path here if you like:
#   [{ "sessionKey": "sk-ant-sid01-..." }]
# CRC_USAGE_CONFIG=/home/you/claude-remote-control/data/usage-accounts.json

# Mac guided login (`crc usage login` / the "Sign in on the Mac" button) opens a
# real browser via Playwright. It reuses your installed Chrome by default:
# CRC_USAGE_LOGIN_CHANNEL=chrome       # or msedge, or empty for bundled Chromium
# CRC_USAGE_LOGIN_TIMEOUT_SECONDS=180  # how long it waits for you to sign in
