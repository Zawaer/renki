node_modules/
dist/
*.tsbuildinfo
.turbo/

# VS Code extension: web bundle is copied in at build time
apps/vscode/media/web/
*.vsix

# Local daemon runtime data (SQLite db, worktrees, logs)
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Env / secrets
.env
.env.*
!.env.example

# Host-specific Docker network wiring (e.g. joining an existing reverse-proxy
# network) — Compose merges this in automatically if present; see SETUP.md.
docker-compose.override.yml

# OS
.DS_Store

# Local Claude Code permission/tool settings — personal, not a project convention
.claude/

# Personal research/decision notes — not project docs, not for the public repo
research-notes.md
dev-workflow-notes.md

# Expo / React Native generated native projects (regenerated by `expo prebuild`
# from app.json + config plugins — not source, so they stay out of git)
.expo/
apps/mobile/android/
apps/mobile/ios/
