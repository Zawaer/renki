{
  "name": "@renki/mac-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lends a Mac's adb (and the phone plugged into it) to a Renki daemon. See README.md.",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/renki-mac-node.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "app": "bash macos/build-app.sh"
  },
  "dependencies": {
    "@renki/protocol": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "^0.21.5",
    "typescript": "^5.7.2"
  }
}
