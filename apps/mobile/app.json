{
  "expo": {
    "name": "Renki",
    "slug": "renki",
    "scheme": "renki",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.zawaer.clauderemotecontrol",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ec9d53"
      }
    },
    "androidNavigationBar": {
      "backgroundColor": "#191918",
      "barStyle": "light-content"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan a pairing QR code from another Renki device \u2014 no photos are taken or stored."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to attach a photo to a prompt \u2014 sent to Claude the same as any other attachment, never stored elsewhere."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.24"
          }
        }
      ],
      "./plugins/withAndroidUserCaTrust.js",
      "./plugins/withAndroidDarkChrome.js"
    ],
    "extra": {
      "eas": {
        "projectId": "56903ad1-4135-4e58-93fa-c7e2b1354aad"
      }
    },
    "owner": "zawaer",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16100b"
    }
  }
}
