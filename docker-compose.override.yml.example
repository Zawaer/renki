# Copy this to docker-compose.override.yml (gitignored — stays local to this
# host). Docker Compose merges an override.yml file in automatically, no
# extra flags needed — `docker compose up -d` picks it up. Only one override
# file is read, so if you need it for more than one reason (e.g. reverse-proxy
# networking below AND the RTK bind-mount from SETUP.md's RTK section), merge
# them into the same `daemon:`/`web:` blocks here rather than keeping separate
# files.
#
# The block below is for a reverse proxy running in its own container that
# needs to reach crc-daemon / crc-web by name.
#
# Set the network name below to whatever your reverse proxy container is
# already attached to (`docker inspect <proxy-container> --format
# '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'` will show it),
# then point its site config at `crc-daemon:4517` / `crc-web:80` instead of
# `127.0.0.1:...`. See SETUP.md § Advanced networking for the full writeup.
#
# daemon and web never talk to each other over Docker networking (the
# browser hits both directly over HTTPS), so there's no need to also keep
# them on Compose's own default network — reverse-proxy alone is enough,
# same as any other single-network service on your reverse proxy.

services:
  daemon:
    networks:
      - reverse-proxy
    # Uncomment whichever of these you need — both live under the SAME
    # `volumes:` key, so uncomment that key once and pick your lines under it.
    # volumes:
    #   # RTK token-savings support — see SETUP.md's RTK section. The
    #   # container-side path must be /root/.local/bin/rtk specifically — that
    #   # directory (not the host-style ~/.local/bin) is the one the Dockerfile
    #   # already adds to PATH, so the *rewritten* Bash commands RTK's hook
    #   # produces (which just say bare `rtk ...`) can actually find it, not
    #   # only the daemon's own hook invocation (which uses CRC_RTK_BIN's
    #   # absolute path directly and would work regardless of PATH).
    #   - ${HOME}/.local/bin/rtk:/root/.local/bin/rtk:ro
    #   # cswap (multi-account usage rotation — see SETUP.md § Multi-account
    #   # usage rotation). cswap itself is already installed INTO the image by
    #   # the Dockerfile, unlike rtk above — it's a pipx-managed Python
    #   # package on the host, so bind-mounting just its shim binary wouldn't
    #   # work (the shim's shebang points at a host-only venv path). What you
    #   # still need to mount is cswap's own account/credential state, so the
    #   # container's cswap sees the same registered accounts as your host's
    #   # `cswap list` — not read-only, since cswap writes back to this on
    #   # every switch/refresh. Only mount this ONE directory — cswap also
    #   # recognizes a legacy `~/.claude-swap-backup` path from older
    #   # versions, and if that path doesn't exist on your host yet, Docker
    #   # will silently create it empty on first `up`, which then makes cswap
    #   # see "both a legacy and a new backup path" and refuse to run at all
    #   # (a migration-safety check, not a bug to work around by mounting it
    #   # too — just don't mount it unless it already has real data on your
    #   # host):
    #   - ${HOME}/.local/share/claude-swap:/root/.local/share/claude-swap
  web:
    networks:
      - reverse-proxy

networks:
  reverse-proxy:
    external: true
