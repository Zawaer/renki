# Copy this to docker-compose.override.yml (gitignored — stays local to this
# host). Docker Compose merges an override.yml file in automatically, no
# extra flags needed — `docker compose up -d` picks it up. Only one override
# file is read, so if you need it for more than one reason (e.g. reverse-proxy
# networking below AND the RTK bind-mount from SETUP.md's RTK section), merge
# them into the same `daemon:`/`web:` blocks here rather than keeping separate
# files.
#
# The block below is for a reverse proxy running in its own container that
# needs to reach crc-daemon / crc-web by name.
#
# Set the network name below to whatever your reverse proxy container is
# already attached to (`docker inspect <proxy-container> --format
# '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'` will show it),
# then point its site config at `crc-daemon:4517` / `crc-web:80` instead of
# `127.0.0.1:...`. See SETUP.md § Advanced networking for the full writeup.
#
# daemon and web never talk to each other over Docker networking (the
# browser hits both directly over HTTPS), so there's no need to also keep
# them on Compose's own default network — reverse-proxy alone is enough,
# same as any other single-network service on your reverse proxy.

services:
  daemon:
    networks:
      - reverse-proxy
    # Uncomment if you're also bind-mounting rtk for RTK token-savings
    # support — see SETUP.md's RTK section. Replace /home/you with the
    # actual path rtk was installed to on this host.
    # volumes:
    #   - ${HOME}/.local/bin/rtk:/home/you/.local/bin/rtk:ro
  web:
    networks:
      - reverse-proxy

networks:
  reverse-proxy:
    external: true
