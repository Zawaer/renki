      "git": true,
      "services": [
        "talkoot",
        "scout"
      ]
    },
    "pihi": {
      "mode": "deploy",
      "dir": "pihi",
      "git": true,
      "services": [
        "pihi"
      ]
    },
    "scout-tool": {
      "mode": "deploy",
      "dir": "scout-tool",
      "git": false,
      "services": [
        "dashboard",
        "worker"
      ]
    },
    "meeting-app": {
      "mode": "deploy",
      "dir": "meeting-app",
      "git": true,
      "services": [
        "kuulo"
      ]
    },
    "otaindex": {
      "mode": "deploy",
      "dir": "otaindex",
      "git": true,
      "services": [
        "otaindex"
      ]
    },
    "contacts": {
      "mode": "deploy",
      "dir": "about-me/contacts",
      "git": false,
      "services": [
