      ]
    },
    "sm-outreach-pipeline": {
      "mode": "deploy",
      "dir": "sm-outreach-pipeline",
      "git": true,
      "services": [
        "app"
      ]
    },
    "ig-outreacher": {
      "mode": "deploy",
      "dir": "ig-outreacher",
      "git": true,
      "services": [
        "ig-outreacher"
      ]
    },
    "claude-accounts": {
      "mode": "deploy",
      "dir": "claude-accounts",
      "git": true,
      "services": [
