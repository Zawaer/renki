    },
    "obsidian-livesync": {
      "mode": "read_only",
      "dir": "obsidian-livesync"
    },
    "beszel": {
      "mode": "read_only",
      "dir": "beszel"
    },
    "backrest": {
      "mode": "read_only",
      "dir": "backrest"
    },
    "dnsmasq": {
      "mode": "read_only",
      "dir": "dnsmasq"
    },
    "caddy": {
      "mode": "read_only",
      "dir": "caddy"
    }
  },
  "protected_containers": [
    "renki-daemon",
    "renki-web",
    "caddy",
    "backrest",
    "immich_*",
    "dawarich_*",
    "obsidian_livesync_couchdb",
    "dnsmasq",
    "beszel*"
