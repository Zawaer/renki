  "backup_covered_roots": [
    "/home/zawaer",
    "/var/lib/docker/volumes"
  ],
  "limits": {
    "logs_max_lines": 2000,
    "output_max_bytes": 200000,
    "command_timeout_seconds": 1800
  },
  "protected_paths": [
    "/home/zawaer/immich",
    "/var/lib/docker/volumes",
    "/home/zawaer/obsidian-livesync",
    "/home/zawaer/backrest",
    "/home/zawaer/screenpipe-archive",
    "/home/zawaer/.ssh",
    "/home/zawaer/.homelab-gateway",
    "/home/zawaer/renki/data",
    "/home/zawaer/about-me/contacts/contacts.json",
    "/home/zawaer/.claude",
    "/home/zawaer/.config"
  ],
  "approval": {
    "timeout_seconds": 300,
    "listen": "172.24.0.1:4530",
    "url": "https://approvals.internal",
    "push_db": "/home/zawaer/renki/data/renki.sqlite"
  },
  "github": {
    "owner": "Zawaer",
    "config_dir": "/var/lib/homelab-gateway/gh"
  }
